LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=shopping
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

SCOUT_DRIVER=database
